/*
tests/test_obj/zero_index.obj - zero index in f
*/
ret = parse_file(&data, "tests/test_obj/zero_index.obj");
ck_assert_int_eq(ret, E_OK);
ck_assert_int_eq(data.vertex_n, 10);
ck_assert_int_eq(data.edge_n, 1);
clear_data(&data);
