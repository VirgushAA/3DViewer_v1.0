ck_assert_double_eq_tol(data.vertexes[9], -0.040342, EPS);
ck_assert_double_eq_tol(data.vertexes[10], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[11], 0.024751 + 900.213, EPS);
ck_assert_double_eq_tol(data.vertexes[12], -0.065479, EPS);
ck_assert_double_eq_tol(data.vertexes[13], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[14], 0.049246 + 900.213, EPS);
ck_assert_double_eq_tol(data.vertexes[15], -0.064496, EPS);
ck_assert_double_eq_tol(data.vertexes[16], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[17], 0.054183 + 900.213, EPS);
ck_assert_double_eq_tol(data.vertexes[18], -0.060793, EPS);
ck_assert_double_eq_tol(data.vertexes[19], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[20], 0.047825 + 900.213, EPS);
ck_assert_double_eq_tol(data.vertexes[21], -0.058867, EPS);
ck_assert_double_eq_tol(data.vertexes[22], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[23], 0.052476 + 900.213, EPS);
ck_assert_double_eq_tol(data.vertexes[24], -0.056475, EPS);
ck_assert_double_eq_tol(data.vertexes[25], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[26], 0.045517 + 900.213, EPS);
ck_assert_double_eq_tol(data.vertexes[27], -0.053679, EPS);
ck_assert_double_eq_tol(data.vertexes[28], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[29], 0.049702 + 900.213, EPS);
clear_data(&data);

/*
Change scale by 27
*/
ret = parse_file(&data, "tests/test_obj/regular.obj");
ck_assert_int_eq(ret, E_OK);
ck_assert_int_eq(data.vertex_n, 10);
ck_assert_int_eq(data.edge_n, 12);
ret = transform_data(&data, ALL, SCALE, 27.0);
ck_assert_int_eq(ret, E_OK);
ck_assert_double_eq_tol(data.vertexes[0], -0.068597 * 27.0, EPS);
ck_assert_double_eq_tol(data.vertexes[1], 2.260834 * 27.0, EPS);
ck_assert_double_eq_tol(data.vertexes[2], 0.049750 * 27.0, EPS);
