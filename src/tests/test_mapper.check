#test mapper

/*
int transform_data(Data* data, Axis axis, Action action, double value);
*/

/*
Passing NULL data
*/
ret = transform_data(NULL, Y, SHIFT, +10.0);
ck_assert_int_eq(ret, E_ARG);

/*
Passing incorrect set of Action and Axis. Doesn't do anything to data and returns E_OK.
*/
ret = parse_file(&data, "tests/test_obj/regular.obj");
ck_assert_int_eq(ret, E_OK);
ck_assert_int_eq(data.vertex_n, 10);
ck_assert_int_eq(data.edge_n, 12);
ret = transform_data(&data, ALL, ROTATE, +10.0);
ck_assert_int_eq(ret, E_OK);
clear_data(&data);

/*
Passing incorrect Action
*/
ret = parse_file(&data, "tests/test_obj/regular.obj");
ck_assert_int_eq(ret, E_OK);
ck_assert_int_eq(data.vertex_n, 10);
ck_assert_int_eq(data.edge_n, 12);
ret = transform_data(&data, Y, 10, +10.0);
ck_assert_int_eq(ret, E_ARG);
clear_data(&data);

/*
Consequence of Y, X, Z shifting by +10.0, -0.002, +900.213 accordingly.
*/
ret = parse_file(&data, "tests/test_obj/regular.obj");
ck_assert_int_eq(ret, E_OK);
ck_assert_int_eq(data.vertex_n, 10);
ck_assert_int_eq(data.edge_n, 12);
ret = transform_data(&data, Y, SHIFT, +10.0);
ck_assert_int_eq(ret, E_OK);
ck_assert_double_eq_tol(data.vertexes[0], -0.068597, EPS);
ck_assert_double_eq_tol(data.vertexes[1], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[2], 0.049750, EPS);
ck_assert_double_eq_tol(data.vertexes[3], -0.068350, EPS);
ck_assert_double_eq_tol(data.vertexes[4], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[5], 0.054760, EPS);
ck_assert_double_eq_tol(data.vertexes[6], -0.043352, EPS);
ck_assert_double_eq_tol(data.vertexes[7], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[8], 0.024505, EPS);
ck_assert_double_eq_tol(data.vertexes[9], -0.038342, EPS);
ck_assert_double_eq_tol(data.vertexes[10], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[11], 0.024751, EPS);
ck_assert_double_eq_tol(data.vertexes[12], -0.063479, EPS);
ck_assert_double_eq_tol(data.vertexes[13], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[14], 0.049246, EPS);
ck_assert_double_eq_tol(data.vertexes[15], -0.062496, EPS);
ck_assert_double_eq_tol(data.vertexes[16], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[17], 0.054183, EPS);
ck_assert_double_eq_tol(data.vertexes[18], -0.058793, EPS);
ck_assert_double_eq_tol(data.vertexes[19], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[20], 0.047825, EPS);
ck_assert_double_eq_tol(data.vertexes[21], -0.056867, EPS);
ck_assert_double_eq_tol(data.vertexes[22], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[23], 0.052476, EPS);
ck_assert_double_eq_tol(data.vertexes[24], -0.054475, EPS);
ck_assert_double_eq_tol(data.vertexes[25], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[26], 0.045517, EPS);
ck_assert_double_eq_tol(data.vertexes[27], -0.051679, EPS);
ck_assert_double_eq_tol(data.vertexes[28], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[29], 0.049702, EPS);

ret = transform_data(&data, X, SHIFT, -0.002);
ck_assert_int_eq(ret, E_OK);
ck_assert_double_eq_tol(data.vertexes[0], -0.070597, EPS);
ck_assert_double_eq_tol(data.vertexes[1], 12.260834, EPS);
ck_assert_double_eq_tol(data.vertexes[2], 0.049750, EPS);
