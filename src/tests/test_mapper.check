clear_data(&data);

/*
Rotate by 1.25 around X
*/
ret = parse_file(&data, "tests/test_obj/regular.obj");
ck_assert_int_eq(ret, E_OK);
ck_assert_int_eq(data.vertex_n, 10);
ck_assert_int_eq(data.edge_n, 12);
ret = transform_data(&data, X, ROTATE, 1.25);
ck_assert_int_eq(ret, E_OK);
/*
      data->vertexes[index * 3 + 1] = y * cos(value) - z * sin(value);
      data->vertexes[index * 3 + 2] = y * sin(value) + z * cos(value);
*/
ck_assert_double_eq_tol(data.vertexes[0], -0.068597, EPS);
ck_assert_double_eq_tol(data.vertexes[1], 2.260834 * cos(1.25) - 0.049750 * sin(1.25), EPS);
